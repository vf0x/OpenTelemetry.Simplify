{
  "dashboard": {
    "id": null,
    "uid": null,
    "title": "OpenTelemetry Service Metrics",
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "5s",
    "panels": [
      {
        "type": "graph",
        "title": "HTTP Request Duration (p95)",
        "id": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "-- Grafana --"
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_bucket[1m])) by (le))",
            "interval": "",
            "legendFormat": "{{le}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 90
                }
              ]
            }
          },
          "overrides": []
        }
      },
      {
        "type": "graph",
        "title": "HTTP Request Rate",
        "id": 2,
        "datasource": {
          "type": "prometheus",
          "uid": "-- Grafana --"
